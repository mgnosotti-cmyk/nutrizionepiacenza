
---
import Base from '../layouts/Base.astro';

const categorie = [
  {
    nome: 'Primi piatti',
    slug: 'primi-piatti',
    immagine: '/images/immagini-categorie-a-tavola/primi-piatti.webp'
  },
  {
    nome: 'Secondi piatti',
    slug: 'secondi-piatti',
    immagine: '/images/immagini-categorie-a-tavola/secondi-piatti.webp'
  },
  {
    nome: 'Dolci',
    slug: 'dolci',
    immagine: '/images/immagini-categorie-a-tavola/dolci.webp'
  },
  {
    nome: 'Bevande',
    slug: 'bevande',
    immagine: '/images/immagini-categorie-a-tavola/bevande.webp'
  },
  {
    nome: 'Antipasti e contorni',
    slug: 'antipasti-e-contorni',
    immagine: '/images/immagini-categorie-a-tavola/antipasti-e-contorni.webp'
  },
  {
    nome: 'Colazioni e merende',
    slug: 'colazioni-e-merende',
    immagine: '/images/immagini-categorie-a-tavola/colazioni-e-merende.webp'
  }
];
---

<Base
  title="A tavola | Maria Giulia Nosotti"
  description="Ricette, alimentazione e salute orale: il gusto di sapere."
>
  <section class="page-hero">
    <span class="eyebrow">A tavola</span>
    <h1>Il gusto di sapere</h1>
    <p>Il piacere di mangiare, la curiosità di conoscere.</p>
  </section>

  <div class="content intro-ricette">
    <p>L'alimentazione è parte della nostra quotidianità: un insieme di sapori, abitudini, tradizioni e scelte che accompagnano ogni fase della vita.</p>
    <p>In questo spazio condivido ricette, idee e curiosità sugli alimenti, con uno sguardo alle loro caratteristiche nutrizionali e alle connessioni con la salute orale.</p>
    <p>Perché conoscere ciò che portiamo in tavola può aiutarci a fare scelte più consapevoli, senza rinunciare al piacere del cibo.</p>
  </div>

  <main class="a-tavola">
    <section class="sezione-categorie" aria-labelledby="titolo-categorie">
      <div class="titolo-sezione">
        <span class="eyebrow">Il ricettario</span>
        <h2 id="titolo-categorie">Esplora per categoria</h2>
        <p>Lasciati ispirare da sapori, ingredienti e nuove idee da portare in tavola.</p>
      </div>

      <div class="griglia-categorie">
        {categorie.map(categoria => (
          <a
            class="categoria-card"
            href={`/a-tavola/${categoria.slug}/`}
            aria-label={`Esplora la categoria ${categoria.nome}`}
          >
            <img
              src={categoria.immagine}
              alt={`Fotografia gastronomica: ${categoria.nome}`}
              loading="lazy"
              width="800"
              height="800"
            />

            <div class="categoria-overlay">
              <h3>{categoria.nome}</h3>
              <span class="linea" aria-hidden="true"></span>
            </div>
          </a>
        ))}
      </div>
    </section>
  </main>
</Base>

<style>
  .intro-ricette {
    margin-bottom: 80px;
  }

  .a-tavola {
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 32px 120px;
  }

  .titolo-sezione {
    margin-bottom: 38px;
  }

  .titolo-sezione h2 {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(34px, 3.8vw, 52px);
    font-weight: 400;
    letter-spacing: -0.035em;
    line-height: 1.12;
    margin: 12px 0 14px;
  }

  .titolo-sezione p {
    font-size: 15px;
    line-height: 1.7;
    opacity: .7;
    max-width: 650px;
  }

  .griglia-categorie {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }

  .categoria-card {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: #e8e3dc;
    color: white;
    text-decoration: none;
    isolation: isolate;
  }

  .categoria-card img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .7s cubic-bezier(.2,.7,.2,1);
  }

  .categoria-card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      transparent 35%,
      rgba(17, 18, 16, .08) 55%,
      rgba(17, 18, 16, .62) 100%
    );
    pointer-events: none;
  }

  .categoria-card:hover img {
    transform: scale(1.055);
  }

  .categoria-card:focus-visible {
    outline: 3px solid #9b8262;
    outline-offset: 3px;
  }

  .categoria-overlay {
    position: absolute;
    z-index: 1;
    left: 8%;
    right: 8%;
    bottom: 9%;
  }

  .categoria-overlay h3 {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(24px, 2.5vw, 37px);
    line-height: 1.12;
    font-weight: 400;
    letter-spacing: -.025em;
    color: #fff;
    margin: 0 0 20px;
    text-shadow: 0 1px 10px rgba(0,0,0,.12);
  }

  .linea {
    display: block;
    width: 48px;
    height: 1px;
    background: rgba(255,255,255,.9);
    transition: width .35s ease;
  }

  .categoria-card:hover .linea {
    width: 80px;
  }

  @media (max-width: 900px) {
    .griglia-categorie {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .intro-ricette {
      margin-bottom: 55px;
    }

    .a-tavola {
      padding: 0 18px 80px;
    }

    .griglia-categorie {
      gap: 9px;
    }

    .categoria-overlay {
      left: 7%;
      right: 7%;
      bottom: 9%;
    }

    .categoria-overlay h3 {
      font-size: clamp(18px, 4.3vw, 25px);
      margin-bottom: 12px;
    }

    .linea {
      width: 30px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .categoria-card img,
    .linea {
      transition: none;
    }
  }
</style>
