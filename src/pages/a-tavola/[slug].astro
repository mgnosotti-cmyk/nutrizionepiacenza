
---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const ricette = await getCollection('ricette');

  const categorie = [
    { nome: 'Primi piatti', slug: 'primi-piatti' },
    { nome: 'Secondi piatti', slug: 'secondi-piatti' },
    { nome: 'Dolci', slug: 'dolci' },
    { nome: 'Bevande', slug: 'bevande' },
    { nome: 'Antipasti e contorni', slug: 'antipasti-e-contorni' },
    { nome: 'Colazioni e dolci', slug: 'colazioni-e-merende' }
  ];

  const normalizza = (testo) =>
    (testo ?? '').trim().toLocaleLowerCase('it');

  const categoriePaths = categorie.map(categoria => ({
    params: { slug: categoria.slug },
    props: {
      tipo: 'categoria',
      categoria,
      ricetteCategoria: ricette
        .filter(ricetta =>
          normalizza(ricetta.data.category) ===
          normalizza(categoria.nome)
        )
        .sort((a, b) =>
          (b.data.date?.getTime() ?? 0) -
          (a.data.date?.getTime() ?? 0)
        )
    }
  }));

  const ricettePaths = ricette
    .filter(ricetta =>
      !categorie.some(categoria => categoria.slug === ricetta.id)
    )
    .map(ricetta => ({
      params: { slug: ricetta.id },
      props: {
        tipo: 'ricetta',
        ricetta
      }
    }));

  return [...categoriePaths, ...ricettePaths];
}

const { tipo, categoria, ricetteCategoria, ricetta } = Astro.props;

let Content;

if (tipo === 'ricetta') {
  const risultato = await render(ricetta);
  Content = risultato.Content;
}
---

<Base
  title={
    tipo === 'categoria'
      ? `${categoria.nome} | A tavola | Maria Giulia Nosotti`
      : `${ricetta.data.title} | Maria Giulia Nosotti`
  }
  description={
    tipo === 'categoria'
      ? `Scopri le ricette della categoria ${categoria.nome}.`
      : ricetta.data.description ?? ''
  }
>
  {tipo === 'categoria' ? (
    <>
      <section class="page-hero">
        <span class="eyebrow">
          <a href="/a-tavola/">A tavola</a> · Il ricettario
        </span>
        <h1>{categoria.nome}</h1>
        <p>Idee, sapori e curiosità da portare in tavola.</p>
      </section>

      <main class="pagina-categoria">
        {ricetteCategoria.length === 0 ? (
          <div class="nessuna-ricetta">
            <p>Nuove ricette in arrivo.</p>
            <a href="/a-tavola/">
              ← Esplora le altre categorie
            </a>
          </div>
        ) : (
          <div class="griglia-ricette">
            {ricetteCategoria.map(item => (
              <a
                class="ricetta-card"
                href={`/a-tavola/${item.id}/`}
              >
                {item.data.image && (
                  <div class="ricetta-immagine">
                    <img
                      src={item.data.image}
                      alt={item.data.title}
                      loading="lazy"
                    />
                  </div>
                )}

                <div class="ricetta-contenuto">
                  <span class="eyebrow">
                    {item.data.category}
                  </span>

                  <h2>{item.data.title}</h2>

                  {item.data.description && (
                    <p>{item.data.description}</p>
                  )}

                  <span class="scopri">
                    Scopri la ricetta ↗
                  </span>
                </div>
              </a>
            ))}
          </div>
        )}

        <div class="ritorno">
          <a class="pill pill-outline" href="/a-tavola/">
            ← Torna alle categorie
          </a>
        </div>
      </main>
    </>
  ) : (
    <>
      <section class="page-hero">
        <span class="eyebrow">
          A tavola · {ricetta.data.category ?? 'Ricette'}
        </span>
        <h1>{ricetta.data.title}</h1>
        {ricetta.data.description && (
          <p>{ricetta.data.description}</p>
        )}
      </section>

      <article class="content">
        {ricetta.data.image && (
          <img
            src={ricetta.data.image}
            alt={ricetta.data.title}
            style="width:100%;aspect-ratio:16/9;object-fit:cover;margin-bottom:60px;"
          />
        )}

        {Content && <Content />}

        <p>
          <a class="pill pill-outline" href="/a-tavola/">
            Torna a tutte le categorie ↗
          </a>
        </p>
      </article>
    </>
  )}
</Base>

<style>
  .page-hero a {
    color: inherit;
    text-decoration: none;
  }

  .pagina-categoria {
    max-width: 1160px;
    margin: 0 auto;
    padding: 0 28px 100px;
  }

  .griglia-ricette {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 48px 30px;
  }

  .ricetta-card {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .ricetta-immagine {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: #f1eee9;
  }

  .ricetta-immagine img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .5s ease;
  }

  .ricetta-card:hover img {
    transform: scale(1.04);
  }

  .ricetta-contenuto {
    padding-top: 22px;
  }

  .ricetta-contenuto h2 {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(24px, 2.5vw, 32px);
    font-weight: 400;
    letter-spacing: -.025em;
    line-height: 1.2;
    margin: 12px 0;
  }

  .ricetta-contenuto p {
    font-size: 15px;
    line-height: 1.7;
    opacity: .72;
    margin-bottom: 18px;
  }

  .scopri {
    display: inline-block;
    font-size: 13px;
    border-bottom: 1px solid currentColor;
    padding-bottom: 5px;
  }

  .nessuna-ricetta {
    padding: 45px 0 70px;
  }

  .nessuna-ricetta p {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 26px;
  }

  .nessuna-ricetta a {
    color: inherit;
    font-size: 14px;
  }

  .ritorno {
    margin-top: 85px;
  }

  @media (max-width: 680px) {
    .pagina-categoria {
      padding: 0 18px 75px;
    }

    .griglia-ricette {
      grid-template-columns: 1fr;
      gap: 42px;
    }

    .ritorno {
      margin-top: 60px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ricetta-immagine img {
      transition: none;
    }
  }
</style>
